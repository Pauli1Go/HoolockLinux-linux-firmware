#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -e

PREREQ=""

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_required_firmware()
{
	if [ ! -f "$1" ]; then
		echo "Missing required HoolockLinux firmware: $1" >&2
		exit 1
	fi

	copy_file firmware "$1"
}

copy_required_firmware /lib/firmware/apple/t8010-smartio.bin
copy_required_firmware /lib/firmware/apple/dfrmtfw-j172-k1f19-6.bin
copy_required_firmware /lib/firmware/regulatory.db
copy_required_firmware /lib/firmware/regulatory.db.p7s

count=0
for firmware in /lib/firmware/brcm/brcmfmac4355c1-pcie.apple,rudderb*; do
	if [ ! -f "$firmware" ]; then
		continue
	fi

	copy_file firmware "$firmware"
	count=$((count + 1))
done

if [ "$count" -ne 24 ]; then
	echo "Expected 24 J172 brcmfmac files, found $count" >&2
	exit 1
fi
